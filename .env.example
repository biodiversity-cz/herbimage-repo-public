# Target of the Vite dev-server `/api` proxy (used by `npm run dev` only).
# Start the local stack first:  docker compose up -d db postgrest
POSTGREST_URL=http://localhost:3000

# Base URL the app calls PostgREST through. The default (`/api`) uses the
# same-origin proxy (Vite dev server in development, nginx in Docker/K8s).
# Only set this when calling PostgREST directly cross-origin – the server
# must then allow CORS for this origin.
#VITE_API_BASE=/api
